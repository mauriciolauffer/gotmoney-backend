{
  "name": "my-first-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "db:start": "wrangler d1 execute dev-gotmoney-db --local --file=./test/data/schema.sql",
    "dev": "pnpm db:start & pnpm start",
    "start": "wrangler dev",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "lint": "prettier . --check --cache && eslint --cache --concurrency=auto",
    "lint:ci": "eslint --quiet -f @microsoft/eslint-formatter-sarif -o eslint.sarif",
    "pretty": "prettier . --write --cache"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.15",
    "@cloudflare/workers-types": "^4.20251213.0",
    "eslint": "^9.39.2",
    "eslint-config-mlauffer-nodejs": "^3.1.0",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vitest": "~4.0.15",
    "wrangler": "^4.54.0"
  },
  "dependencies": {
    "hono": "^4.11.0"
  }
}
